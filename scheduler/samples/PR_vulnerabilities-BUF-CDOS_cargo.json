{
  "publish": {
    "server": "default",
    "storage_path": "${PUBLISHER_STORAGE}/tlspuffin4/PR/${COMMIT_ID}/VulnC/",
    "goal": "Vuln PR/Commit ${COMMIT_ID}"
    },
  "configurations": {
    "CDOS": {
      "args": {
        "experiment": "CDOS",
        "features": "wolfssl530,fix-CVE-2022-39173",
        "vendor": "wolfssl:wolfssl530-cdos"
      }
    },
    "BUF": {
      "args": {
        "experiment": "BUF",
        "features": "wolfssl540,fix-CVE-2022-42905",
        "vendor": "wolfssl:wolfssl510-buf"
      }
    }
  },
  "name" : "Vulnerabilities (subset CDOS, BUF from group A) search - ${COMMIT_ID}",
  "flow" : [
    {
      "step": "Init"
    }, 
    [
      {
        "run": [ "CDOS", "BUF" ],
        "configuration": {
          "nb_retry": 5
        }
      },
      {
        "step": "ForcedBuild"
      },
      {
        "step": "ExperimentWithCargo",
        "configuration": {
          "nb_cores": 4,
          "timeout": "190m"
        },
        "monitor": {
          "entry_point": "MonitorExperiment",
          "delay_start": "10s",
          "interval": "60s"
        }
      },
      {
        "step": "ExperimentEnd"
      }
    ],
    {
      "step": "SummaryRun"
    },
    {
      "step": "ManageResults",
      "configuration": {
        "args": {
          "vulnerabilities": "CDOS BUF",
          "script": "/local-unsafe/demengeo/XP/scripts/reports_generate"
        }
      }
    },
    {
      "step": "CleanAllRepo"
    }
  ]
}
