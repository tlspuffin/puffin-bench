{
  "publish": {
    "server": "default",
    "storage_path": "${PUBLISHER_STORAGE}/tlspuffin3/PR/${COMMIT_ID}/Perf/",
    "goal": "Perf PR/Commit ${COMMIT_ID}"
  },
  "configurations": {
    "LibreSSL": {
      "args": {
        "experiment": "LibreSSL 333",
        "features": "libressl"
      }
    },
    "BoringSSL": {
      "args": {
        "experiment": "BoringSSL 202403",
        "features": "asan,boringssl202403"
      }
    },
    "OpenSSL": {
      "args": {
        "experiment": "OpenSSL",
        "features": "asan,openssl111k",
        "vendor": "openssl:openssl340-asan"
      }
    },
    "WolfSSL": {
      "args": {
        "experiment": "WolfSSL",
        "features": "asan,wolfssl540",
        "vendor": "wolfssl:wolfssl580-asan"
      }
    }
  },
  "name" : "Performance - ${COMMIT_ID}",
  "flow" : [
    {
      "step": "Init"
    },
    {
      "step": "Build",
      "run": [
        "LibreSSL",
        "BoringSSL",
        "OpenSSL",
        "WolfSSL"
      ]
    },
    {
      "step": "Experiment",
      "run": [
        "LibreSSL",
        "BoringSSL",
        "OpenSSL",
        "WolfSSL"
      ],
      "configuration": {
        "nb_cores": 3,
        "timeout": "1h",
        "nb_retry": 5
      },
      "monitor": {
        "entry_point": "MonitorExperiment",
        "delay_start": "10s",
        "interval": "60s"
      }
    },
    {
      "step": "SummaryRun"
    },
    {
      "step": "Clean"
    }
  ]
}
