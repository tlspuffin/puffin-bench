{
  "publish": {
    "server": "http://127.0.0.1:8081/api/notify",
    "storage_path": "/home/olivier/Desktop/Archives/${COMMIT_ID}/${task_id}/"
  },
  "configurations": {
    "SDOS2": {
      "args": {
        "features": "'wolfssl540,wolfssl-disable-postauth,fix-CVE-2022-39173'",
        "extra_flags": "'--put-use-clear'"
      }
    },
    "SDOS1": {
      "args": {
        "features": "'openssl111j'"
      }
    },
    "SIG": {
      "args": {
        "features": "'wolfssl510,fix-CVE-2022-25640,fix-CVE-2022-39173'"
      }
    },
    "HEAP": {
      "args": {
        "features": "'wolfssl540,asan,fix-CVE-2022-39173'"
      }
    },
    "CDOS": {
      "args": {
        "features": "'wolfssl530,fix-CVE-2022-39173'"
      }
    },
    "SKIP": {
      "args": {
        "features": "'wolfssl510,fix-CVE-2022-25638,fix-CVE-2022-39173'"
      }
    },
    "BUF": {
      "args": {
        "features": "'wolfssl540,fix-CVE-2022-42905'"
      }
    }
  },
  "name" : "Vulnerabilities search - ${COMMIT_ID}",
  "flow" : [
    { 
      "step": "Init"
    },
    {
      "step": "Build",
      "run": [ "SDOS2", "SDOS1", "HEAP" ]
    },
    {
      "step": "Experiment",
      "run": [ 
        { 
          "configuration": "SDOS2",
          "override": {
            "timeout": "10m"
          }
        }, 
        "SDOS1", 
        "HEAP"
      ],
      "configuration": {
        "nb_cores": 1,
        "timeout": "1m",
        "nb_retry": 2
      },
      "monitor": {
        "entry_point": "CheckObjectif",
        "delay_start": "30s",
        "interval": "1m"
      }
    },
    {
      "step": "ManageResults",
      "configuration": {
        "args": {
          "vulnerabilities": "SDOS2 SDOS1 HEAP",
          "script": "/home/olivier/Desktop/Exec/scripts/reports_generate"
        }
      }
    }
  ]
}
