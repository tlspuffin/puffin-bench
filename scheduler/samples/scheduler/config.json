        "base_url": "http://127.0.0.1:10083",
        "notify_endpoint": "/api/notify",
        "view_endpoint": "/files/${PACKAGE}#${TASK_ID}",
        "storage": "/home/olivier/Desktop/Archives"
      }
    },
    "runPath": "runs",
    "userPath": "users_data",
    "exportPath": "exports",
    "toolsPath": "tools"
  },
  "cache": {
    "storagePath": "cache",
    "mappingFile": "cache.json"
  }
}
