{
  "server": {
    "secure": false,
    "key": "security/site.key",
    "cert": "security/site.pem",
    "CA": "security/CA.pem",
    "hostname": "localhost", 
    "port": 10082, 
    "html": "html"
  },
  "schedule": {
    "executors": {
      "local": {
        "name": "local",
        "type": 1,
        "nbCores": 1,
        "excludeCores": [
          0
        ],
        "scriptPath": "../scripts"
      }
