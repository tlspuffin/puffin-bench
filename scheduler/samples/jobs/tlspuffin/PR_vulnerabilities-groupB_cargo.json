{
  "publish": {
    "server": "default",
    "storage": "${PROJECT}/PR/${COMMIT_ID}/Vuln/",
    "goal": "Vuln PR/Commit ${COMMIT_ID}"
  },
  "configurations": {
    "SDOS1": {
      "args": {
      "experiment": "SDOS1",
        "features": "openssl111j",
        "vendor": "openssl:openssl111j"
      }
    },
    "SIG": {
      "args": {
      "experiment": "SIG",
        "features": "wolfssl510,fix-CVE-2022-25640,fix-CVE-2022-39173",
        "vendor": "wolfssl:wolfssl510-sig"
      }
    }
  },
  "name" : "Vulnerabilities (group B) search - ${COMMIT_ID}",
  "flow" : [
    {
      "step": "Init",
      "configuration": {
          "nb_cores": 4
        }
    },
    [
      {
        "run": [ ],
        "configuration": {
          "nb_cores": 1,
          "nb_retry": 90
        },
        "streams": [
          { "name": "error", "path": "current_log/error.log" }
        ]
      },
      {
        "step": "ForcedBuild"
      },
      {
        "step": "ExperimentWithCargo",
        "configuration": {
          "timeout": "2890m"
        },
        "monitor": {
          "entry_point": "MonitorExperiment",
          "delay_start": "10s",
          "interval": "60s"
        }
      },
      {
        "step": "ExperimentEnd"
      }
    ],
    {
      "step": "SummaryRun"
    },
    {
      "step": "CleanAllRepo"
    }
  ]
}
