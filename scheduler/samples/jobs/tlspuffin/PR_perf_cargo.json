{
  "publish": {
    "server": "default",
    "storage": "${PACKAGE}/PR/${COMMIT_ID}/Perf/",
    "goal": "Perf PR/Commit ${COMMIT_ID}"
  },
  "configurations": {
    "LibreSSL": {
      "args": {
        "experiment": "LibreSSL",
        "required_features": "introspection",
        "features": "asan,libressl",
        "vendor": "libressl:libressl421-asan"
      }
    },
    "BoringSSL": {
      "args": {
        "experiment": "BoringSSL",
        "required_features": "introspection",
        "features": "asan,boringssl202403",
        "vendor": "boringssl:boringssl20260508-asan"
      }
    },
    "OpenSSL": {
      "args": {
        "experiment": "OpenSSL",
        "required_features": "introspection",
        "features": "asan,openssl111k",
        "vendor": "openssl:openssl340-asan"
      }
    },
    "WolfSSL": {
      "args": {
        "experiment": "WolfSSL",
        "required_features": "introspection",
        "features": "asan,wolfssl540",
        "vendor": "wolfssl:wolfssl580-asan"
      }
    }
  },
  "args": {
    "TYPE": "perf"
  },
  "name" : "Performance - ${COMMIT_ID}",
  "flow" : [
    {
      "step": "Init"
    }, 
    [
      {
        "run": [ ],
        "configuration": {
          "nb_retry": 5,
          "nb_cores": 3
        },
        "streams": [
          { "name": "error", "path": "current_log/error.log" }
        ]
      },
      {
        "step": "ForcedBuild"
      },
      {
        "step": "ExperimentWithCargo",
        "configuration": {
          "timeout": "70m"
        },
        "monitor": {
          "entry_point": "MonitorExperiment",
          "delay_start": "10s",
          "interval": "60s"
        }
      },
      {
        "step": "ExperimentEnd"
      }
    ],
    {
      "step": "SummaryRun"
    },
    {
      "step": "CleanAllRepo"
    }
  ]
}

