{
  "publish": {
    "server": "http://127.0.0.1:8081/api/notify",
    "storage_path": "/local-unsafe/demengeo/XP/archives/${COMMIT_ID}/PR/Perf/${task_id}/",
    "goal": "Mesurer PR/Commit ${COMMIT_ID}"
    },
  "configurations": {
    "LibreSSL": {
      "args": {
        "experiment": "LibreSSL 333",
        "features": "'asan,libressl333'"
      }
    },
    "BoringSSL": {
      "args": {
	      "experiment": "BoringSSL 202403",
        "features": "'asan,boringssl202403'"
      }
    },
    "OpenSSL": {
      "args": {
	      "experiment": "OpenSSL",
        "features": "'asan,openssl111k'",
        "vendor": "openssl:openssl340-asan"
      }
    },
    "WolfSSL": {
      "args": {
	      "experiment": "WolfSSL",
        "features": "'asan,wolfssl540'",
        "vendor": "wolfssl:wolfssl580-asan"
      } 
    }
  },
  "name" : "Performance - ${COMMIT_ID}",
  "flow" : [
    {
      "step": "Init"
    },
    {
      "step": "Build",
      "run": [ 
        "LibreSSL", 
	      "BoringSSL",
        "OpenSSL",
        "WolfSSL"
      ]
    },
    {
      "step": "Experiment",
      "run": [ 
        "LibreSSL", 
	      "BoringSSL",
        "OpenSSL",
        "WolfSSL"
      ],
      "configuration": {
        "nb_cores": 3,
        "timeout": "1h",
        "nb_retry": 5
      },
      "monitor": {
        "entry_point": "CheckObjectif",
        "delay_start": "10s",
        "interval": "60s"
      }
    }
  ]
}
